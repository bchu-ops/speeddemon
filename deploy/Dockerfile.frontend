# Stage 1: Build Node apps
FROM node:20-slim AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# In production, we build static files
RUN npm run build

# Stage 2: Serve with Nginx (or keep Node for Dev)
FROM node:20-slim
WORKDIR /app
COPY --from=builder /app .
EXPOSE 3000
CMD ["npm", "run", "dev"]