# Development: Simple single-stage for dev with hot reload
FROM node:20-slim
WORKDIR /app

# Copy package files first for better caching
COPY frontend/package*.json ./

# Install dependencies (will be Linux-compatible)
RUN npm install

# Copy source code
COPY frontend/ .

EXPOSE 3000

# Default command (can be overridden in docker-compose.yml)
CMD ["npm", "run", "dev"]